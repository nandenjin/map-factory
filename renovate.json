{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["* * 5,15,25 * *"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "rangeStrategy": "pin",
  "automerge": true,
  "automergeType": "branch",
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "rangeStrategy": "replace"
    }
  ]
}
